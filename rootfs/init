#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /run /tmp

hostname "$(cat /etc/hostname 2>/dev/null || echo carsonlinux)"

echo
echo "================================"
echo "        Welcome to CarsonLinux"
echo "================================"
echo
echo "XFCE live desktop starting..."
echo "Live user: live"
echo

exec /sbin/init
